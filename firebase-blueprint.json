{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products for the shop",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "customizable": { "type": "boolean" },
        "hasNameAndSurname": { "type": "boolean" },
        "isSuaHistoria": { "type": "boolean" },
        "sku": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "stock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "imageUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "shippingInfo": { "type": "object" },
        "paymentInfo": { "type": "object" },
        "bling_nfe_number": { "type": "string" },
        "melhorenvio_label_id": { "type": "string" },
        "melhorenvio_tracking_code": { "type": "string" }
      },
      "required": ["userId", "items", "total", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profiles",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "address": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global app settings",
      "type": "object",
      "properties": {
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupons system",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "value"] },
        "value": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "type", "value", "active"]
    }
  },
  "firestore": {
    "/products": {
      "schema": "Product",
      "description": "Collection of all products available in the shop"
    },
    "/orders": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/users": {
      "schema": "User",
      "description": "Registered user profiles"
    },
    "/settings": {
      "schema": "Settings",
      "description": "Global application settings"
    },
    "/coupons": {
      "schema": "Coupon",
      "description": "Store discount coupons"
    }
  }
}
