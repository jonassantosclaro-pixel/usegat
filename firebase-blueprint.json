{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products for the shop",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "customizable": { "type": "boolean" },
        "hasNameAndSurname": { "type": "boolean" },
        "isSuaHistoria": { "type": "boolean" },
        "sku": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "stock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "imageUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "shippingInfo": { "type": "object" },
        "paymentInfo": { "type": "object" },
        "bling_nfe_number": { "type": "string" },
        "melhorenvio_label_id": { "type": "string" },
        "melhorenvio_tracking_code": { "type": "string" }
      },
      "required": ["userId", "items", "total", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profiles",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "address": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global app settings",
      "type": "object",
      "properties": {
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupons system",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "value"] },
        "value": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "type", "value", "active"]
    },
    "Category": {
      "title": "Category",
      "description": "Category for products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Subcategory": {
      "title": "Subcategory",
      "description": "Subcategory belonging to a Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "categoryId"]
    },
    "Variation": {
      "title": "Variation",
      "description": "Customizable product variations with option choices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "options": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "options"]
    }
  },
  "firestore": {
    "/products": {
      "schema": "Product",
      "description": "Collection of all products available in the shop"
    },
    "/orders": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/users": {
      "schema": "User",
      "description": "Registered user profiles"
    },
    "/settings": {
      "schema": "Settings",
      "description": "Global application settings"
    },
    "/coupons": {
      "schema": "Coupon",
      "description": "Store discount coupons"
    },
    "/categories": {
      "schema": "Category",
      "description": "Collection of product categories"
    },
    "/subcategories": {
      "schema": "Subcategory",
      "description": "Collection of subcategories"
    },
    "/variations": {
      "schema": "Variation",
      "description": "Collection of dynamic product variations and option choices"
    }
  }
}
